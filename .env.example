# Copie este arquivo para .env e preencha suas chaves
# cp .env.example .env

# ── CoinGecko ────────────────────────────────────────────────
# Demo key gratuita: coingecko.com → API → Get Demo API Key
COINGECKO_DEMO_KEY=sua_chave_aqui

# ── Etherscan ────────────────────────────────────────────────
# Key gratuita: etherscan.io → Sign In → API Keys
ETHERSCAN_API_KEY=sua_chave_aqui

# ── GitHub ───────────────────────────────────────────────────
# Token gratuito: github.com → Settings → Developer settings → Personal access tokens
# Scopes: nenhum (apenas leitura de repos públicos)
GITHUB_TOKEN=sua_chave_aqui

# ── Gemini (Google) ──────────────────────────────────────────
# Mesmo do projeto equity
GEMINI_API_KEY=sua_chave_aqui

# ── Tokenomist (opcional) ────────────────────────────────────
# Free trial: docs.tokenomist.ai
# Sem key: campos de unlock aparecem como N/D no relatório
TOKENOMIST_API_KEY=